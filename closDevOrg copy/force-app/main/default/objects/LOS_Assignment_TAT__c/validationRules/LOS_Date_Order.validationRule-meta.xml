<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LOS_Date_Order</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(LOS_Assignment_End__c)), LOS_Assignment_End__c &lt; LOS_Assignment_Start__c)</errorConditionFormula>
    <errorMessage>End must be on or after start.</errorMessage>
</ValidationRule>
