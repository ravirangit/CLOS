<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LOS_Date_Order</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(LOS_End_Date_Time__c)), LOS_End_Date_Time__c &lt; LOS_Start_Date_Time__c)</errorConditionFormula>
    <errorMessage>End must be on or after start.</errorMessage>
</ValidationRule>
